<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>_refFriendlyQuests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>2.1.0</Version>
    <!-- The two lines below will set the output path for the binaries -->
    <OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.1" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.1" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.1" />
  </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>None</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>
    <PropertyGroup>
        <TarkovDir Condition=" '$(TarkovDir)' == '' ">D:\SPT 4.0.0 DEV\</TarkovDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <PropertyGroup>
            <ModOutputDir>$(TarkovDir)SPT\user\mods\$(ProjectName)\</ModOutputDir>
            <ReleaseOutputDir>$(ProjectDir)release\$(ProjectName)\SPT\user\mods\$(ProjectName)\</ReleaseOutputDir>
            <ZipFile>$(ProjectDir)release\$(ProjectName).7z</ZipFile>
            <SevenZipExe>"C:\Program Files\7-Zip\7z.exe"</SevenZipExe>
            <CopyToTarkovDir Condition="Exists('$(TarkovDir)')">true</CopyToTarkovDir>
            <CopyToTarkovDir Condition="!Exists('$(TarkovDir)')">false</CopyToTarkovDir>
            <HasSevenZip Condition="Exists('C:\Program Files\7-Zip\7z.exe')">true</HasSevenZip>
            <HasSevenZip Condition="!Exists('C:\Program Files\7-Zip\7z.exe')">false</HasSevenZip>
        </PropertyGroup>

        <ItemGroup>
            <ServerComponents Include="$(ProjectDir)bin\$(Configuration)\$(ProjectName)\*.*" />
            <Data Include="$(ProjectDir)db\*.*" />
        </ItemGroup>

        <Copy SourceFiles="@(ServerComponents)" DestinationFolder="$(ModOutputDir)%(RecursiveDir)" Condition="'$(CopyToTarkovDir)' == 'true'" />
        <Copy SourceFiles="@(Data)" DestinationFolder="$(ModOutputDir)db\%(RecursiveDir)" Condition="'$(CopyToTarkovDir)' == 'true'" />

        <MakeDir Directories="$(ProjectDir)release" Condition="!Exists('$(ProjectDir)release')" />
        <MakeDir Directories="$(ReleaseOutputDir)" Condition="!Exists('$(ReleaseOutputDir)')" />

        <Copy SourceFiles="@(ServerComponents)" DestinationFolder="$(ReleaseOutputDir)%(RecursiveDir)" />
        <Copy SourceFiles="@(Data)" DestinationFolder="$(ReleaseOutputDir)db\%(RecursiveDir)" />

        <Delete Files="$(ZipFile)" Condition="Exists('$(ZipFile)')" />

        <Exec Command='$(SevenZipExe) a -t7z "$(ZipFile)" "$(ProjectDir)release\$(ProjectName)\*" -mx=5 -m0=lzma2' Condition="'$(HasSevenZip)' == 'true'" />
    </Target>
    
</Project>
